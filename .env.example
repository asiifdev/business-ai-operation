DATABASE_URL=postgres://root@127.0.0.1:5432/ai_business_operation
# Meta Model API (https://dev.meta.ai/platform) -- never commit the real key
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# "demo" allows the cheaper -contributor models (Meta trains on the content): fake data only. Default is "standard".
AI_DATA_MODE=standard
# Optional model override for chat (default muse-spark-1.3)
AI_CHAT_MODEL=

# App
APP_URL=http://localhost:4321
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
DATABASE_URL_TEST=postgres://root@127.0.0.1:5432/ai_business_operation_test

# Telegram (create the bot with BotFather; never commit the token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# File storage: "r2" (Cloudflare R2, S3 API) or "disk" (local/tests)
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
# Path to ffmpeg for meeting audio (M09). Leave empty to use the one on PATH.
FFMPEG_PATH=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Production server (pnpm start): address to listen on
HOST=127.0.0.1
PORT=4321

# Public site (BRD-M16). All optional; features switch on when a value is present.
SITE_CONTACT_EMAIL=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_DEMO_VIDEO_URL=
REGISTRATION_DAILY_CAP=50

# Spoken replies for voice notes in Telegram (D-052). Run `pnpm tts:setup` once and they turn on by themselves.
# PIPER_DIR=.piper
# PIPER_VOICE_ID=id_ID-news_tts-medium
# PIPER_VOICE_EN=en_US-libritts_r-medium
# PIPER_EN_SPEAKER=40

# Connections and deployment operations (M17).
# Master key that encrypts connection secrets (SSH passwords/keys, aaPanel API keys) in the database. 32 random bytes, base64:
#   openssl rand -base64 32
# Use a DIFFERENT key on the live server. If it is lost, saved secrets must be entered again. Never commit it.
CONNECTIONS_KEY=

# The platform's GitHub App (one App for all organizations; each organization installs it on its own account).
# Create it at https://github.com/settings/apps/new (permissions: Contents read-only, Metadata read-only).
# GITHUB_APP_ID and GITHUB_APP_SLUG are public. GITHUB_APP_PRIVATE_KEY is the .pem from "Generate a private key", kept on
# ONE line with \n for the line breaks, and is a secret.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Secret you type into the App's webhook settings; deliveries are accepted only if signed with it. openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Verifies who installed the App (D-057): the App's OAuth credentials. Public id, secret client secret.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The one public address of the app. The GitHub App's Callback URL, Setup URL and Webhook URL all live under it (D-058).
# APP_URL=https://ai-business.asiifdev.com

# Public address(es) Orbyte's server connects FROM, comma separated. Shown on the Connections page so owners can allow them
# in an aaPanel IP whitelist or an SSH firewall. Leave empty to hide the hint.
# EGRESS_IPS=

# Development only: allow connections to private/loopback addresses (a local test server). Leave unset in production.
# ALLOW_PRIVATE_CONNECTIONS=1
