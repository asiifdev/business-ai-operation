---
import { brand } from '../../config/brand';
import { pagePath, site, type Locale } from '../../config/site';
import type { PageSlug } from '../../content/site/types';
import { ui } from '../../content/site/ui';
import { fill, getPage } from '../../lib/marketing';
import { buttonClasses } from '../ui/Button';
import { Wordmark } from '../brand/LogoMark';

interface Props {
  locale: Locale;
  flush?: boolean;
}
const { locale, flush = false } = Astro.props;
const u = ui[locale];
const label = (slug: PageSlug) => fill(getPage(locale, slug).h1);
const col = (slugs: PageSlug[]) => slugs.map((s) => ({ href: pagePath(locale, s), text: label(s) }));
const columns = [
  { title: u.footer.product, links: col(['product', 'product/action-center', 'product/billing', 'product/meetings', 'product/telegram', 'product/marketing-studio']) },
  { title: u.footer.resources, links: col(['how-it-works', 'security', 'pricing', 'compare', 'faq', 'changelog']) },
  { title: u.footer.company, links: col(['about', 'contact']) },
  { title: u.footer.legal, links: col(['privacy', 'terms']) },
];
const machine = [
  { href: '/llms.txt', text: 'llms.txt' },
  { href: '/llms-full.txt', text: 'llms-full.txt' },
  { href: '/pricing.md', text: 'pricing.md' },
  { href: '/sitemap.xml', text: 'sitemap.xml' },
];
const year = new Date().getUTCFullYear();
---

<footer class={`${flush ? '' : 'mt-16'} bg-paper-2`}>
  <div class="wrap py-14">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Wordmark name={brand.name} className="text-3xl text-ink sm:text-5xl" />
        <p class="mt-3 mb-0 text-ink-2">{brand.tagline[locale]}</p>
      </div>
      <a href="/register" data-cta="register" class={buttonClasses('primary', 'md', undefined, 'pill')}>{u.getStarted}</a>
    </div>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="m-0 font-display text-sm font-semibold text-ink">{c.title}</p>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {c.links.map((l) => <li><a href={l.href} class="text-sm text-ink-2 hover:text-ink hover:underline underline-offset-4">{l.text}</a></li>)}
          </ul>
        </nav>
      ))}
      <nav aria-label={u.footer.machine}>
        <p class="m-0 font-display text-sm font-semibold text-ink">{u.footer.machine}</p>
        <ul class="m-0 mt-3 list-none space-y-2 p-0">
          {machine.map((l) => <li><a href={l.href} class="font-mono text-sm text-ink-2 hover:text-ink hover:underline underline-offset-4">{l.text}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
  <div class="bg-paper-3">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-4 text-sm text-ink-2">
      <p class="m-0">© {year} {brand.name}. {u.labels.madeBy} <a href={brand.publisher.url} rel="noopener" class="text-ink underline underline-offset-4">{brand.publisher.legalName}</a>.</p>
      <p class="m-0 flex flex-wrap items-center gap-4">
        <a href={brand.repository} rel="noopener" class="text-ink-2 hover:text-ink hover:underline underline-offset-4">{u.labels.repository}</a>
        {site.gaMeasurementId && <button type="button" data-consent-open class="cursor-pointer border-0 bg-transparent p-0 text-ink-2 underline underline-offset-4 hover:text-ink">{u.footer.consent}</button>}
      </p>
    </div>
  </div>
</footer>
