---
import { brand } from '../../config/brand';
import { pagePath, type Locale } from '../../config/site';
import type { PageSlug } from '../../content/site/types';
import { ui } from '../../content/site/ui';
import { otherLocale } from '../../lib/marketing';
import { LogoMark, Wordmark } from '../brand/LogoMark';
import { AccountLink } from './AccountLink';
import { MarketingThemeToggle } from './MarketingThemeToggle';

interface Props {
  locale: Locale;
  slug: PageSlug | null;
}
const { locale, slug } = Astro.props;
const u = ui[locale];
const other = otherLocale(locale);
const nav: { label: string; slug: PageSlug }[] = [
  { label: u.nav.product, slug: 'product' },
  { label: u.nav.howItWorks, slug: 'how-it-works' },
  { label: u.nav.security, slug: 'security' },
  { label: u.nav.pricing, slug: 'pricing' },
  { label: u.nav.faq, slug: 'faq' },
];
const switchHref = pagePath(other, slug ?? '');
const linkClass = 'rounded-full px-3 py-1.5 text-sm text-ink-2 transition-colors duration-(--duration-micro) hover:bg-paper-3 hover:text-ink aria-[current=page]:bg-paper-3 aria-[current=page]:text-ink motion-reduce:transition-none';
---

<header class="sticky top-0 z-40 pt-3">
  <div class="wrap">
    <div class="flex items-center justify-between gap-3 rounded-full border border-rule bg-paper/95 shadow-sm py-2 pr-2 pl-4 backdrop-blur-md sm:pl-5">
      <a href={pagePath(locale, '')} class="inline-flex items-center gap-2 font-display text-lg font-semibold text-ink no-underline">
        <LogoMark size={26} />
        <Wordmark name={brand.name} className="text-sm" />
      </a>

      <nav aria-label={locale === 'en' ? 'Main' : 'Utama'} class="hidden items-center gap-1 md:flex">
        {nav.map((n) => <a href={pagePath(locale, n.slug)} class={linkClass} aria-current={slug === n.slug ? 'page' : undefined}>{n.label}</a>)}
      </nav>

      <div class="flex items-center gap-2">
        <a href={switchHref} hreflang={other} lang={other} class="rounded-full border border-rule-2 px-3 py-1 font-display text-sm font-medium text-ink-2 hover:text-ink" aria-label={other === 'id' ? 'ID, Bahasa Indonesia' : 'EN, English'}>{other.toUpperCase()}</a>
        <MarketingThemeToggle client:idle lightLabel={locale === 'en' ? 'Switch to light theme' : 'Ganti ke tema terang'} darkLabel={locale === 'en' ? 'Switch to dark theme' : 'Ganti ke tema gelap'} />
        <span class="hidden items-center gap-2 sm:flex">
          <AccountLink client:idle signInLabel={u.signIn} getStartedLabel={u.getStarted} openAppLabel={u.openApp} />
        </span>
        <details class="relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center rounded-full bg-paper-3 px-3 py-1.5 font-display text-sm font-medium text-ink">Menu</summary>
          <nav aria-label={locale === 'en' ? 'Mobile' : 'Seluler'} class="absolute right-0 mt-3 flex w-60 flex-col rounded-card border border-rule bg-paper p-3 shadow-pop">
            {nav.map((n) => <a href={pagePath(locale, n.slug)} class="rounded-lg px-3 py-2 text-ink-2 hover:bg-paper-3 hover:text-ink">{n.label}</a>)}
            <a href="/login" class="rounded-lg px-3 py-2 text-ink-2 hover:bg-paper-3 hover:text-ink">{u.signIn}</a>
            <a href="/register" data-cta="register" class="rounded-lg px-3 py-2 font-medium text-accent hover:bg-paper-3">{u.getStarted}</a>
          </nav>
        </details>
      </div>
    </div>

  </div>
</header>
