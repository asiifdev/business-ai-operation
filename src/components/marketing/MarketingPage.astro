---
import { brand } from '../../config/brand';
import { pagePath, site, type Locale } from '../../config/site';
import { competitors, formatIdr, formatUsd, plans, pricingAsOf } from '../../content/pricing';
import { dataItems, notYetAvailable, processors, storageItems } from '../../content/data-practices';
import { features } from '../../content/features';
import type { PageSlug } from '../../content/site/types';
import { ui } from '../../content/site/ui';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { inlineMarkup, readChangelog } from '../../lib/changelog';
import { longDate } from '../../lib/dates';
import { buildJsonLd } from '../../lib/jsonld';
import { breadcrumbs, fill, getPage } from '../../lib/marketing';
import { buttonClasses } from '../ui/Button';
import { BillingToggle } from './BillingToggle';
import CapabilityBento from './CapabilityBento.astro';
import CtaBand from './CtaBand.astro';
import ControlsList from './ControlsList.astro';
import StatusBadge from './StatusBadge.astro';
import { HeroDemo } from './HeroDemo';
import { HowItWorks } from './HowItWorks';
import PricingTeaser from './PricingTeaser.astro';
import TrustStrip from './TrustStrip.astro';

interface Props {
  locale: Locale;
  slug: PageSlug;
}
const { locale, slug } = Astro.props;
const page = getPage(locale, slug);
const u = ui[locale];
const L = u.labels;
const crumbs = breadcrumbs(locale, slug, u.home);
const feature = features.find((f) => f.page === slug);
const jsonLd = buildJsonLd(locale, slug, u.home);
const usd = locale === 'en';
const changelog = slug === 'changelog' ? readChangelog() : { unreleased: [] };
const isHome = slug === '';
// One container (".wrap") for header, content and footer. Never a different max-width here.
const panel = 'wrap py-4';
const card = 'rounded-card bg-paper-2 p-6 sm:p-8';
const h2 = 'm-0 font-display text-2xl font-semibold text-ink sm:text-3xl';
const cell = 'px-3 py-3 text-left align-top text-sm text-ink-2';
const head = 'px-3 py-2 text-left align-bottom font-display text-sm font-semibold text-ink';
---

<MarketingLayout locale={locale} slug={slug} title={page.title} description={page.description} jsonLd={jsonLd} flushFooter={isHome}>
  <main id="content" class="pt-4">
    {!isHome && (
      <nav aria-label={locale === 'en' ? 'Breadcrumb' : 'Jejak halaman'} class="wrap pt-8">
        <ol class="m-0 flex list-none flex-wrap items-center gap-1 p-0 text-sm text-muted">
          {crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.url.replace(site.url, '') || '/'} class="text-ink-2 underline underline-offset-4 hover:text-ink">{fill(c.name)}</a> : <span aria-current="page">{fill(c.name)}</span>}
              {i < crumbs.length - 1 && <span aria-hidden="true"> /</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    {isHome && page.home ? (
      <header class="wrap pt-10 pb-8 sm:pt-16">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-10">
          <div>
            <h1 class="m-0 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl lg:text-[4.25rem] lg:leading-[1.04]">
              {fill(page.h1).split(page.home.h1Accent)[0]}<span class="text-gradient">{page.home.h1Accent}</span>{fill(page.h1).split(page.home.h1Accent)[1]}
            </h1>
            <p class="mt-6 mb-0 max-w-xl text-lg leading-relaxed text-ink-2 sm:text-xl">{fill(page.answer)}</p>
            <div class="mt-9 flex flex-wrap items-center gap-3">
              <a href="/register" data-cta="register" class={buttonClasses('primary', 'md', undefined, 'pill')}>{page.home.ctaPrimary}</a>
              <a href={pagePath(locale, 'how-it-works')} class={buttonClasses('secondary', 'md', undefined, 'pill')}>{page.home.ctaSecondary}</a>
            </div>
            <p class="mt-5 mb-0 text-sm text-muted">{page.home.note}</p>
          </div>
          <div class="parallax-slow">
            <HeroDemo client:idle text={u.illustration} pauseLabel={L.pause} playLabel={L.play} org={L.demoOrg} appName={brand.name} />
          </div>
        </div>
      </header>
    ) : (
      <header class="wrap pt-6 pb-8">
        <h1 class="m-0 max-w-4xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-6xl">{fill(page.h1)}</h1>
        <p class="mt-5 mb-0 max-w-3xl text-lg leading-relaxed text-ink-2 sm:text-xl">{fill(page.answer)}</p>
        {feature && <p class="mt-5 mb-0 flex items-center gap-2 text-sm text-muted">{L.status}: <StatusBadge status={feature.status} locale={locale} /></p>}
      </header>
    )}

    {isHome && page.home && (
      <>
        <TrustStrip locale={locale} />

        <div class="band-grid">
          <HowItWorks client:visible stages={page.home.stages} text={u.illustration} heading={page.home.howHeading} intro={page.home.howIntro} />
        </div>

        <section class="band-soft py-16" data-reveal>
          <div class="wrap">
            <h2 class={h2}>{L.availability}</h2>
            <p class="mt-2 mb-8 max-w-2xl text-ink-2">{L.availabilityIntro}</p>
            <CapabilityBento locale={locale} tone="paper" />
          </div>
        </section>

        <section class="wrap py-20">
          <ControlsList locale={locale} heading={page.home.controlsHeading} items={page.home.controls} />
        </section>

        <section class="wrap py-8" data-reveal>
          <PricingTeaser locale={locale} />
        </section>
      </>
    )}

    {slug === 'product' && (
      <section class="wrap py-8" data-reveal>
        <h2 class={h2}>{L.capabilities}</h2>
        <p class="mt-2 mb-8 max-w-2xl text-ink-2">{L.availabilityIntro}</p>
        <CapabilityBento locale={locale} />
      </section>
    )}

    {slug === 'pricing' && (
      <section class="wrap py-8" data-pricing data-billing="annual">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class={h2}>{L.planned}</h2>
          {usd && <BillingToggle client:idle annualLabel={L.billedAnnually} monthlyLabel={L.billedMonthly} target="[data-pricing]" />}
        </div>
        <ul class="m-0 mt-8 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
          {plans.map((p) => (
            <li class="flex flex-col rounded-card bg-paper-2 p-6 transition-colors duration-(--duration-micro) hover:bg-paper-3 motion-reduce:transition-none">
              <h3 class="m-0 font-display text-xl font-semibold text-ink">{p.name}</h3>
              <p class="mt-1 mb-4 text-sm text-ink-2">{p.audience[locale]}</p>
              <p class="m-0 font-display text-3xl font-semibold text-ink">
                {p.usdAnnual === null ? L.custom : usd ? (
                  p.usdAnnual === 0 ? L.free : (<><span data-annual>{formatUsd(p.usdAnnual)}</span><span data-monthly>{formatUsd(p.usdMonthly ?? p.usdAnnual)}</span></>)
                ) : p.idrAnnual === 0 ? L.free : formatIdr(p.idrAnnual ?? 0)}
              </p>
              {p.usdAnnual !== null && p.usdAnnual !== 0 && (
                <p class="mt-1 mb-0 text-sm text-muted">{L.perUserMonth}{usd && <> · <span data-annual>{L.billedAnnually}</span><span data-monthly>{L.billedMonthly}</span></>}{!usd && <> · {L.billedAnnually}</>}</p>
              )}
              {p.minUsers && <p class="mt-1 mb-0 text-sm text-muted">{L.minUsers}: {p.minUsers}</p>}
              <ul class="m-0 mt-5 list-disc space-y-2 pl-5 text-sm text-ink-2">{p.limits[locale].map((l) => <li>{l}</li>)}</ul>
            </li>
          ))}
        </ul>
        <p class="mt-5 mb-0 text-sm text-muted">{L.asOf} <time datetime={pricingAsOf}>{longDate(locale, pricingAsOf)}</time>. <a href="/pricing.md" class="text-accent underline underline-offset-4">{L.pricingMd}</a>.</p>
      </section>
    )}

    {slug === 'compare' && (
      <section class="wrap py-8">
        <h2 class={h2}>{L.vendorPrices}</h2>
        <div class="mt-6 overflow-x-auto rounded-card bg-paper-2 p-2">
          <table class="w-full min-w-[36rem] border-collapse">
            <caption class="sr-only">{L.vendorPrices}</caption>
            <thead><tr><th scope="col" class={head}>{locale === 'en' ? 'Tool' : 'Alat'}</th><th scope="col" class={head}>{locale === 'en' ? 'Public price' : 'Harga publik'}</th><th scope="col" class={head}>{L.sources}</th></tr></thead>
            <tbody>
              {competitors.map((c) => (
                <tr class="odd:bg-paper-3/50">
                  <th scope="row" class={`${cell} font-display font-semibold text-ink`}>{c.vendor}</th>
                  <td class={cell}>{c.summary[locale]}{c.note && <span class="mt-1 block text-muted">{c.note[locale]}</span>}</td>
                  <td class={cell}><a href={c.source} rel="noopener" class="text-accent underline underline-offset-4">{c.source.replace('https://', '').replace(/\/$/, '')}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 mb-0 text-sm text-muted">{L.asOf} <time datetime={pricingAsOf}>{longDate(locale, pricingAsOf)}</time>.</p>
      </section>
    )}

    {slug === 'changelog' && (
      <section class="wrap py-8">
        {changelog.unreleased.length === 0 && <p class="text-ink-2">{L.changelogEmpty}</p>}
        {changelog.unreleased.map((g) => (
          <div class={`${card} mb-4`}>
            <h2 class={h2}>{g.title} · {L.unreleased}</h2>
            <ul class="m-0 mt-4 list-disc space-y-2 pl-5 text-ink-2">{g.items.map((it) => <li set:html={inlineMarkup(it)} />)}</ul>
          </div>
        ))}
      </section>
    )}

    {slug === 'privacy' && (
      <section class="wrap space-y-4 py-8">
        <div class={card}>
          <h2 class={h2}>{L.dataItems}</h2>
          <dl class="m-0 mt-5 space-y-4">
            {dataItems.map((d) => <div><dt class="font-display font-semibold text-ink">{d.title[locale]}</dt><dd class="m-0 mt-1 text-ink-2">{d.body[locale]}</dd></div>)}
          </dl>
        </div>
        <div class={card}>
          <h2 class={h2}>{L.storage}</h2>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse">
              <caption class="sr-only">{L.storage}</caption>
              <thead><tr><th scope="col" class={head}>{L.name}</th><th scope="col" class={head}>{L.purpose}</th><th scope="col" class={head}>{L.whenSet}</th></tr></thead>
              <tbody>
                {storageItems.map((s) => (
                  <tr class="odd:bg-paper-3/50">
                    <th scope="row" class={`${cell} font-mono text-ink`}>{s.name}<span class="block font-body text-muted">{s.kind === 'cookie' ? 'Cookie' : 'Local storage'}</span></th>
                    <td class={cell}>{s.purpose[locale]}</td>
                    <td class={cell}>{s.whenSet[locale]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class={card}>
          <h2 class={h2}>{L.processors}</h2>
          <ul class="m-0 mt-5 list-none space-y-4 p-0">
            {processors.map((p) => (
              <li class="rounded-input bg-paper p-4">
                <p class="m-0 font-display font-semibold text-ink">{p.name}{p.inDevelopment && <span class="ml-2 text-sm font-normal text-muted">({locale === 'en' ? 'in development' : 'sedang dikembangkan'})</span>}</p>
                <p class="mt-1 mb-0 text-sm text-ink-2">{p.purpose[locale]}</p>
                <p class="mt-1 mb-0 text-sm text-ink-2">{p.data[locale]}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class={card}>
          <h2 class={h2}>{L.notYet}</h2>
          <ul class="m-0 mt-4 list-disc space-y-2 pl-5 text-ink-2">{notYetAvailable.map((n) => <li>{n[locale]}</li>)}</ul>
          <p class="mt-6 mb-0 text-ink-2">{locale === 'en' ? 'Questions or requests:' : 'Pertanyaan atau permintaan:'} <a href={`mailto:${site.contactEmail}`} class="text-accent underline underline-offset-4">{site.contactEmail}</a></p>
        </div>
      </section>
    )}

    {slug === 'contact' && (
      <section class="wrap py-8">
        <div class={card}><p class="m-0 text-xl"><span class="text-muted">{L.contactBy}: </span><a href={`mailto:${site.contactEmail}`} class="font-medium text-accent underline underline-offset-4">{site.contactEmail}</a></p></div>
      </section>
    )}

    {slug === 'about' && (
      <section class="wrap py-4">
        <div class={card}><p class="m-0 text-ink-2">{L.madeBy} <a href={brand.publisher.url} rel="noopener" class="text-accent underline underline-offset-4">{brand.publisher.legalName} ({brand.publisher.brand})</a>. <a href={brand.repository} rel="noopener" class="text-accent underline underline-offset-4">{L.repository}</a>.</p></div>
      </section>
    )}

    {page.sections && page.sections.length > 0 && (
      <div class="wrap space-y-4 py-6">
        {page.sections.map((s) => (
          <section class={`${card} grid gap-4 lg:grid-cols-12`} data-reveal>
            <h2 class={`${h2} lg:col-span-4`}>{fill(s.heading)}</h2>
            <div class="lg:col-span-8">
              {s.paragraphs?.map((p) => <p class="m-0 mb-3 text-ink-2 last:mb-0">{fill(p)}</p>)}
              {s.bullets && <ul class="m-0 list-disc space-y-2 pl-5 text-ink-2">{s.bullets.map((b) => <li>{fill(b)}</li>)}</ul>}
            </div>
          </section>
        ))}
      </div>
    )}

    {page.faq && page.faq.length > 0 && (
      <section class="wrap py-12">
        <div class={isHome ? 'grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16' : ''}>
          <div class={isHome ? 'lg:sticky lg:top-28 lg:self-start' : ''}>
            <h2 class={isHome ? `${h2} sm:text-4xl` : h2}>{L.faqHeading}</h2>
            {isHome && <p class="mt-4 mb-0"><a href={pagePath(locale, 'faq')} class="text-accent underline underline-offset-4">{u.nav.faq}</a></p>}
          </div>
          <div class={`${isHome ? '' : 'mt-6'} space-y-3`}>
            {page.faq.map((f, i) => (
              <details open={i === 0 && slug === 'faq'} class="group rounded-card bg-paper-2 p-5 transition-colors duration-(--duration-micro) open:bg-paper-3 motion-reduce:transition-none">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-ink">
                  <h3 class="m-0 text-lg font-semibold">{fill(f.q)}</h3>
                  <span aria-hidden="true" class="text-ink-2 transition-transform duration-(--duration-micro) group-open:rotate-45 motion-reduce:transition-none">+</span>
                </summary>
                <p class="mt-3 mb-0 max-w-3xl text-ink-2">{fill(f.a)}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <p class="wrap pt-6 pb-8 text-sm text-muted">{L.updated}: <time datetime={page.updated}>{longDate(locale, page.updated)}</time></p>

    {isHome && page.home && <CtaBand locale={locale} text={page.home.closing} cta={page.home.ctaPrimary} />}

  </main>
</MarketingLayout>
