---
import AppShell from '../../../layouts/AppShell.astro';
import { SubscriptionDetail } from '../../../components/billing/SubscriptionDetail';

export const prerender = false;
if (Astro.locals.user!.role === 'staff') return Astro.redirect('/app'); // billing is for Owner and Admin
const { id } = Astro.params;
---

<AppShell title="Langganan" current="subscriptions">
  <SubscriptionDetail client:load id={id!} />
</AppShell>
