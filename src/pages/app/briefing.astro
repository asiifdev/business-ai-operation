---
import AppShell from '../../layouts/AppShell.astro';
import { BriefingPage } from '../../components/actions/BriefingPage';

export const prerender = false;
if (Astro.locals.user!.role === 'staff') return Astro.redirect('/app/action-center'); // money figures: Owner and Admin only
---

<AppShell title="Briefing" current="briefing">
  <BriefingPage client:load timezone={Astro.locals.timezone} />
</AppShell>
